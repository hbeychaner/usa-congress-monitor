FROM ghcr.io/astral-sh/uv:python3.13-bookworm AS api

WORKDIR /workspace

# Keep the virtual environment outside the bind-mounted project folder
# so container installs are stable across host tooling differences.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

# Prime dependency metadata layer for better caching.
COPY pyproject.toml uv.lock requirements.txt ./

# Copy project package so editable installs/import paths are available.
COPY cdm ./cdm

RUN uv sync --frozen --no-dev --no-cache --no-default-groups

COPY documentation/opensearch_mappings.yaml documentation/opensearch_mappings.yaml

CMD ["sh", "-c", "exec uvicorn cdm.backend.app:app --host 0.0.0.0 --port ${PORT:-8080}"]

FROM api AS analysis

RUN uv sync --frozen --no-dev --no-cache --group analysis
