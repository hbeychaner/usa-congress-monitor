#!/bin/bash
set -euo pipefail

mkdir -p /mnt/data
DISK=/dev/disk/by-id/google-data
blkid "$DISK" >/dev/null 2>&1 || mkfs.ext4 -m 0 -F "$DISK"
grep -q "/mnt/data" /etc/fstab || echo "$DISK /mnt/data ext4 discard,defaults,nofail 0 2" >> /etc/fstab
mount -a

# Docker's data root lives on the persistent disk so volumes survive VM rebuilds.
mkdir -p /etc/docker /mnt/data/docker
echo '{"data-root": "/mnt/data/docker"}' > /etc/docker/daemon.json

if ! command -v docker >/dev/null; then
  apt-get update
  apt-get install -y ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
  echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list
  apt-get update
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
fi
systemctl restart docker

sysctl -w vm.max_map_count=262144
echo "vm.max_map_count=262144" > /etc/sysctl.d/99-elasticsearch.conf

mkdir -p /mnt/data/es
chown 1000:0 /mnt/data/es

PASSWORD=$(gcloud secrets versions access latest --secret=${elastic_password_secret})

docker rm -f elasticsearch >/dev/null 2>&1 || true
docker run -d --name elasticsearch --restart unless-stopped -p 9200:9200 \
  -e discovery.type=single-node \
  -e ELASTIC_PASSWORD="$PASSWORD" \
  -e xpack.security.enabled=true \
  -e xpack.security.http.ssl.enabled=false \
  -e ES_JAVA_OPTS="-Xms${heap_gb}g -Xmx${heap_gb}g" \
  -v /mnt/data/es:/usr/share/elasticsearch/data \
  docker.elastic.co/elasticsearch/elasticsearch:${elasticsearch_version}

until curl -sf -u "elastic:$PASSWORD" http://localhost:9200 >/dev/null; do sleep 5; done

# Publish an application API key once; later boots keep the existing one.
if ! gcloud secrets versions list ${api_key_secret} --limit=1 --format='value(name)' | grep -q .; then
  KEY=$(curl -sf -u "elastic:$PASSWORD" -H 'Content-Type: application/json' \
    -X POST http://localhost:9200/_security/api_key -d '{"name":"congress-app"}' \
    | python3 -c 'import sys, json; print(json.load(sys.stdin)["encoded"])')
  printf %s "$KEY" | gcloud secrets versions add ${api_key_secret} --data-file=-
fi
