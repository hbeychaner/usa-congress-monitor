FROM ghcr.io/astral-sh/uv:python3.13-bookworm AS api

WORKDIR /workspace

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:${PATH}"

COPY pyproject.toml uv.lock requirements.txt ./
COPY cdm ./cdm
COPY scripts ./scripts
COPY documentation/opensearch_mappings.yaml ./documentation/opensearch_mappings.yaml

RUN uv sync --frozen --no-dev --no-cache --no-default-groups

# Cloud Run supplies PORT; the worker VM overrides this command.
CMD ["sh", "-c", "exec uvicorn cdm.backend.app:app --host 0.0.0.0 --port ${PORT:-8080}"]

FROM api AS analysis

RUN uv sync --frozen --no-dev --no-cache --group analysis
