{
    "name": "congress-tracker-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "contracts:generate": "openapi-typescript \"${OPENAPI_URL:-http://localhost:8000/openapi.json}\" -o src/shared/contracts/api.ts",
        "predev": "npm run contracts:generate",
        "dev": "vite",
        "prebuild": "npm run contracts:generate",
        "build": "tsc -b && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@radix-ui/react-navigation-menu": "^1.2.8",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-simple-maps": "^3.0.0",
        "react-router-dom": "^6.30.1"
    },
    "devDependencies": {
        "@types/node": "^22.17.2",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/react-simple-maps": "^1.0.0",
        "@vitejs/plugin-react": "^4.5.0",
        "openapi-typescript": "^7.9.1",
        "typescript": "^5.8.3",
        "vite": "^6.3.5"
    }
}