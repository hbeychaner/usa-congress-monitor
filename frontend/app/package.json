{
    "name": "congress-tracker-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22.18.0"
    },
    "scripts": {
        "contracts:generate": "node scripts/generate-contracts.mjs",
        "contracts:check": "node scripts/generate-contracts.mjs --check",
        "audit": "npm audit --audit-level=low",
        "test": "node --test tests/*.test.mjs && tsc --noEmit --strict --skipLibCheck --moduleResolution bundler --module esnext --target ES2020 --types vite/client tests/contracts.types.ts",
        "test:browser": "tsc --noEmit -p tsconfig.browser.json && playwright test",
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "@radix-ui/themes": "^3.3.0",
        "@sigma/edge-curve": "^3.1.0",
        "echarts": "^6.1.0",
        "graphology": "^0.26.0",
        "graphology-communities-louvain": "^2.0.2",
        "graphology-layout-forceatlas2": "^0.10.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.5",
        "react-simple-maps": "^3.0.0",
        "sigma": "^3.0.3"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^22.17.2",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/react-simple-maps": "^1.0.0",
        "@vitejs/plugin-react": "^4.5.0",
        "typescript": "^5.8.3",
        "vite": "^6.4.5"
    },
    "overrides": {
        "@hey-api/json-schema-ref-parser": {
            "js-yaml": "4.3.2"
        },
        "d3-color": "3.1.0"
    }
}
